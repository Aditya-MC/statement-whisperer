# Copy to `.env` (git-ignored) and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Leave unset to use backend/ledger.db (SQLite). For Postgres use e.g.
#   postgresql+psycopg://user:pass@localhost:5432/ledger   (needs a Postgres driver installed)
# DATABASE_URL=sqlite:///D:/path/to/ledger.db
# Neon/hosted Postgres works as-is (pure-Python pg8000 driver, TLS from sslmode):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require

# Optional: an EMPTY Postgres database for tests/test_postgres.py (refuses non-empty DBs).
# TEST_POSTGRES_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/ledger_test?sslmode=require

# --- LLM --------------------------------------------------------------------
# Provider: "anthropic" for real calls, "none" to turn automatic detection off (manual column
# mapping, rule-based categories), "fake" for offline demo data.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model used for schema inference (one call per new statement, small masked sample).
# Cheaper alternatives: claude-sonnet-5-5, claude-haiku-5-5.
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - how much the model reasons before answering.
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=60

# --- Uploads ----------------------------------------------------------------
# Uploads are processed in memory and never written to disk by the app.
MAX_UPLOAD_MB=20

# --- Accounts & sessions ----------------------------------------------------
# On a public server, set this to YOUR email: only it can create the first (admin) account.
# Leave empty locally, where the first sign-up becomes admin and claims existing data.
# ADMIN_EMAIL=you@example.com
# Send the session cookie over HTTPS only. Set to true when deployed.
COOKIE_SECURE=false
SESSION_DAYS=30

# --- App --------------------------------------------------------------------
# DEMO_MODE=true forces the fake LLM provider and is meant for synthetic data only.
DEMO_MODE=false
LOG_LEVEL=INFO
# Built UI served at "/" when present (default: frontend/dist). Dev uses Vite on :5173 instead.
# FRONTEND_DIST=D:/path/to/frontend/dist
