# Copy to `.env` (git-ignored) and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# SQLite file (default). For Postgres use e.g.
#   postgresql+psycopg://user:pass@localhost:5432/ledger
DATABASE_URL=sqlite:///./ledger.db

# --- LLM --------------------------------------------------------------------
# Provider: "anthropic" for real calls, "fake" for offline/demo (no network).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model used for schema inference (small masked sample of rows).
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=60

# --- Uploads ----------------------------------------------------------------
# Temporary folder for uploads. Files are deleted right after parsing.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# --- App --------------------------------------------------------------------
# DEMO_MODE=true forces the fake LLM provider and is meant for synthetic data only.
DEMO_MODE=false
LOG_LEVEL=INFO
